# ─── Required ────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=your-bot-token-here
REPORT_CHAT_ID=123456789
LOG_CHAT_ID=123456789
ADMIN_USER_IDS=[123456789]

# ─── Optional (defaults shown) ───────────────────────────────────────────────
REPORT_TIME=08:00
TIMEZONE=Europe/Moscow
REQUEST_TIMEOUT=10
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_TIMEOUT=60
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
OUTLIER_THRESHOLD_CRYPTO=30.0
OUTLIER_THRESHOLD_STOCKS=15.0

# ─── External API keys (optional — free tier works without them) ──────────────
# COINGECKO_API_KEY=your-coingecko-key
# EXCHANGERATE_API_KEY=your-exchangerate-key
COINMARKETCAP_API_KEY=
FIXER_API_KEY=
CURRENCYLAYER_API_KEY=
ALPHAVANTAGE_API_KEY=
